{
  "name": "turanslate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist-secrets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm --prefix worker run typecheck",
    "typecheck:web": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "db:migrate:local": "npm --prefix worker run db:migrate:local",
    "db:migrate:remote": "npm --prefix worker run db:migrate:remote",
    "users:sync:local": "npm --prefix worker run users:sync:local",
    "users:sync:remote": "npm --prefix worker run users:sync:remote",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm --prefix worker run check"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
