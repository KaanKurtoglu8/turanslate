# Copy to .env.local for local frontend development.
# Everything prefixed with VITE_ is bundled into public browser code: NEVER put secrets here.
# The OpenAI key belongs only in worker/.dev.vars (local) or a Cloudflare Worker secret (production).

# URL of the Turanslate Worker API (wrangler dev defaults to port 8787).
VITE_API_BASE_URL=http://localhost:8787
